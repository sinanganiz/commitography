{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sinanganiz/commitography/docs/report-schema.json",
  "title": "Commitography report",
  "description": "report.json: one repository, at one commit, under one analysis configuration (ADR-0021). docs/metrics.md defines every metric, reason code and cardinality limit it carries (ADR-0062). Within a document major version no field is removed and no field's meaning changes (ADR-0031). Consumers ignore unknown fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_version",
    "metadata",
    "repository",
    "configuration",
    "identities",
    "families"
  ],
  "properties": {
    "document_version": {
      "type": "object",
      "additionalProperties": false,
      "description": "The version of the document's structure (ADR-0031 clause 1).",
      "required": [
        "major",
        "minor"
      ],
      "properties": {
        "major": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "minor": {
          "type": "integer"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "description": "The only section whose values differ between two runs over one commit and configuration. Comparison tooling excludes it by path (ADR-0021 clause 6).",
      "required": [
        "generated_at",
        "tool_version"
      ],
      "properties": {
        "generated_at": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "commit"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "description": "The analysed commit."
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "description": "The fully resolved analysis configuration the report was produced under (ADR-0026 clauses 2 and 3): the resolved result only, with no layer and no precedence. Its keys are the analysis plane's keys, so it is a configuration file: passing it back to the command reproduces this report outside the metadata section (clause 4). No operational value appears here, and every value that identifies a person is a reference rather than a raw address (ADR-0068). Filled in document version 1.3.",
      "required": [
        "identities",
        "exclude_authors",
        "exclude_paths",
        "outlier_threshold_lines",
        "count_merges",
        "date_source",
        "use_mailmap",
        "anonymize",
        "since",
        "until",
        "year",
        "recency_window_days",
        "cardinality_limits"
      ],
      "properties": {
        "identities": {
          "type": "array",
          "description": "The identity merges the analysis applied. Each address is the identity digest that refers to it (ADR-0068 clause 2).",
          "items": {
            "$ref": "#/$defs/configuredIdentity"
          }
        },
        "exclude_authors": {
          "type": "array",
          "description": "The resolved author exclusion list: the built-in entries and those the configuration added, in order. An entry is a name, a class pattern such as a bot name suffix, or an identity reference; under anonymised output a name that excluded a person is written as a reference to that identity (ADR-0068 clauses 4 and 5).",
          "items": {
            "type": "string"
          }
        },
        "exclude_paths": {
          "type": "array",
          "description": "The resolved path exclusion list, in order.",
          "items": {
            "type": "string"
          }
        },
        "outlier_threshold_lines": {
          "type": "integer",
          "description": "Effective lines above which a commit is bulk (docs/metrics.md section 1)."
        },
        "count_merges": {
          "type": "boolean"
        },
        "date_source": {
          "type": "string",
          "enum": [
            "author",
            "committer"
          ]
        },
        "use_mailmap": {
          "type": "boolean"
        },
        "anonymize": {
          "type": "boolean"
        },
        "since": {
          "type": "string",
          "description": "The instant git resolved the lower date bound to, in RFC 3339, or empty for no bound. The instant is recorded rather than the expression: git completes a bare date with the current time of day, so the expression would select different commits at another hour."
        },
        "until": {
          "type": "string",
          "description": "The instant git resolved the upper date bound to, in RFC 3339, or empty for no bound."
        },
        "year": {
          "type": "integer",
          "description": "The calendar year the analysis was restricted to, or 0 for the whole history."
        },
        "recency_window_days": {
          "type": "integer",
          "description": "The work-type recency window (docs/metrics.md section 1)."
        },
        "cardinality_limits": {
          "$ref": "#/$defs/cardinalityLimits"
        }
      }
    },
    "identities": {
      "type": "array",
      "description": "The resolved contributors a reader selects from (ADR-0010 clause 2), docs/metrics.md section 14. Not a metric family. Individual entries are ordered by first commit date ascending, ties broken by id (ADR-0009 clause 3); at most 200 appear individually, and the rest fold into one aggregate entry, last (ADR-0018 clause 4). No entry carries a raw address (ADR-0033 clause 2). Added in document version 1.1; source address counts and merge candidates added in 1.2.",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/identity"
          },
          {
            "$ref": "#/$defs/aggregateIdentity"
          }
        ]
      }
    },
    "families": {
      "type": "object",
      "additionalProperties": false,
      "description": "Every family of ADR-0024 clause 5, each with a version and a status (ADR-0031 clause 2, ADR-0032).",
      "required": [
        "temporal",
        "commit-size",
        "messages",
        "files",
        "coupling",
        "ownership",
        "worktype",
        "ai-archaeology",
        "hotspot",
        "static-analysis"
      ],
      "properties": {
        "temporal": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "description": "Computed and reliable.",
              "required": [
                "version",
                "status",
                "metrics"
              ],
              "properties": {
                "version": {
                  "$ref": "#/$defs/version"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "ok"
                  ]
                },
                "method": {
                  "type": "string",
                  "description": "How the values were derived, where that differs from a measurement or a reference implementation (ADR-0032 clause 8)."
                },
                "metrics": {
                  "$ref": "#/$defs/temporalMetrics"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "description": "Computed, with a reason and a confidence indicator.",
              "required": [
                "version",
                "status",
                "reasons",
                "confidence",
                "metrics"
              ],
              "properties": {
                "version": {
                  "$ref": "#/$defs/version"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "degraded"
                  ]
                },
                "reasons": {
                  "$ref": "#/$defs/reasons"
                },
                "confidence": {
                  "$ref": "#/$defs/confidence"
                },
                "method": {
                  "type": "string",
                  "description": "How the values were derived, where that differs from a measurement or a reference implementation (ADR-0032 clause 8)."
                },
                "metrics": {
                  "$ref": "#/$defs/temporalMetrics"
                }
              }
            },
            {
              "$ref": "#/$defs/skippedFamily"
            }
          ]
        },
        "commit-size": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "description": "Computed and reliable.",
              "required": [
                "version",
                "status",
                "metrics"
              ],
              "properties": {
                "version": {
                  "$ref": "#/$defs/version"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "ok"
                  ]
                },
                "method": {
                  "type": "string",
                  "description": "How the values were derived, where that differs from a measurement or a reference implementation (ADR-0032 clause 8)."
                },
                "metrics": {
                  "$ref": "#/$defs/commitSizeMetrics"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "description": "Computed, with a reason and a confidence indicator.",
              "required": [
                "version",
                "status",
                "reasons",
                "confidence",
                "metrics"
              ],
              "properties": {
                "version": {
                  "$ref": "#/$defs/version"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "degraded"
                  ]
                },
                "reasons": {
                  "$ref": "#/$defs/reasons"
                },
                "confidence": {
                  "$ref": "#/$defs/confidence"
                },
                "method": {
                  "type": "string",
                  "description": "How the values were derived, where that differs from a measurement or a reference implementation (ADR-0032 clause 8)."
                },
                "metrics": {
                  "$ref": "#/$defs/commitSizeMetrics"
                }
              }
            },
            {
              "$ref": "#/$defs/skippedFamily"
            }
          ]
        },
        "messages": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "description": "Computed and reliable.",
              "required": [
                "version",
                "status",
                "metrics"
              ],
              "properties": {
                "version": {
                  "$ref": "#/$defs/version"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "ok"
                  ]
                },
                "method": {
                  "type": "string",
                  "description": "How the values were derived, where that differs from a measurement or a reference implementation (ADR-0032 clause 8)."
                },
                "metrics": {
                  "$ref": "#/$defs/messagesMetrics"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "description": "Computed, with a reason and a confidence indicator.",
              "required": [
                "version",
                "status",
                "reasons",
                "confidence",
                "metrics"
              ],
              "properties": {
                "version": {
                  "$ref": "#/$defs/version"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "degraded"
                  ]
                },
                "reasons": {
                  "$ref": "#/$defs/reasons"
                },
                "confidence": {
                  "$ref": "#/$defs/confidence"
                },
                "method": {
                  "type": "string",
                  "description": "How the values were derived, where that differs from a measurement or a reference implementation (ADR-0032 clause 8)."
                },
                "metrics": {
                  "$ref": "#/$defs/messagesMetrics"
                }
              }
            },
            {
              "$ref": "#/$defs/skippedFamily"
            }
          ]
        },
        "files": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "description": "Computed and reliable.",
              "required": [
                "version",
                "status",
                "metrics"
              ],
              "properties": {
                "version": {
                  "$ref": "#/$defs/version"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "ok"
                  ]
                },
                "method": {
                  "type": "string",
                  "description": "How the values were derived, where that differs from a measurement or a reference implementation (ADR-0032 clause 8)."
                },
                "metrics": {
                  "$ref": "#/$defs/filesMetrics"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "description": "Computed, with a reason and a confidence indicator.",
              "required": [
                "version",
                "status",
                "reasons",
                "confidence",
                "metrics"
              ],
              "properties": {
                "version": {
                  "$ref": "#/$defs/version"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "degraded"
                  ]
                },
                "reasons": {
                  "$ref": "#/$defs/reasons"
                },
                "confidence": {
                  "$ref": "#/$defs/confidence"
                },
                "method": {
                  "type": "string",
                  "description": "How the values were derived, where that differs from a measurement or a reference implementation (ADR-0032 clause 8)."
                },
                "metrics": {
                  "$ref": "#/$defs/filesMetrics"
                }
              }
            },
            {
              "$ref": "#/$defs/skippedFamily"
            }
          ]
        },
        "coupling": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "description": "Computed and reliable.",
              "required": [
                "version",
                "status",
                "metrics"
              ],
              "properties": {
                "version": {
                  "$ref": "#/$defs/version"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "ok"
                  ]
                },
                "method": {
                  "type": "string",
                  "description": "How the values were derived, where that differs from a measurement or a reference implementation (ADR-0032 clause 8)."
                },
                "metrics": {
                  "$ref": "#/$defs/couplingMetrics"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "description": "Computed, with a reason and a confidence indicator.",
              "required": [
                "version",
                "status",
                "reasons",
                "confidence",
                "metrics"
              ],
              "properties": {
                "version": {
                  "$ref": "#/$defs/version"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "degraded"
                  ]
                },
                "reasons": {
                  "$ref": "#/$defs/reasons"
                },
                "confidence": {
                  "$ref": "#/$defs/confidence"
                },
                "method": {
                  "type": "string",
                  "description": "How the values were derived, where that differs from a measurement or a reference implementation (ADR-0032 clause 8)."
                },
                "metrics": {
                  "$ref": "#/$defs/couplingMetrics"
                }
              }
            },
            {
              "$ref": "#/$defs/skippedFamily"
            }
          ]
        },
        "ownership": {
          "$ref": "#/$defs/skippedFamily",
          "description": "Not implemented yet; present as skipped (ADR-0032 clause 1)."
        },
        "worktype": {
          "$ref": "#/$defs/skippedFamily",
          "description": "Not implemented yet; present as skipped (ADR-0032 clause 1)."
        },
        "ai-archaeology": {
          "$ref": "#/$defs/skippedFamily",
          "description": "Not implemented yet; present as skipped (ADR-0032 clause 1)."
        },
        "hotspot": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "description": "Computed and reliable.",
              "required": [
                "version",
                "status",
                "metrics"
              ],
              "properties": {
                "version": {
                  "$ref": "#/$defs/version"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "ok"
                  ]
                },
                "method": {
                  "type": "string",
                  "description": "How the values were derived, where that differs from a measurement or a reference implementation (ADR-0032 clause 8)."
                },
                "metrics": {
                  "$ref": "#/$defs/hotspotMetrics"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "description": "Computed, with a reason and a confidence indicator.",
              "required": [
                "version",
                "status",
                "reasons",
                "confidence",
                "metrics"
              ],
              "properties": {
                "version": {
                  "$ref": "#/$defs/version"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "degraded"
                  ]
                },
                "reasons": {
                  "$ref": "#/$defs/reasons"
                },
                "confidence": {
                  "$ref": "#/$defs/confidence"
                },
                "method": {
                  "type": "string",
                  "description": "How the values were derived, where that differs from a measurement or a reference implementation (ADR-0032 clause 8)."
                },
                "metrics": {
                  "$ref": "#/$defs/hotspotMetrics"
                }
              }
            },
            {
              "$ref": "#/$defs/skippedFamily"
            }
          ]
        },
        "static-analysis": {
          "$ref": "#/$defs/skippedFamily",
          "description": "Not implemented yet; present as skipped (ADR-0032 clause 1)."
        }
      }
    }
  },
  "$defs": {
    "configuredIdentity": {
      "type": "object",
      "additionalProperties": false,
      "description": "One identity merge, as the configuration section carries it.",
      "required": [
        "emails"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "The name the configuration gave the identity, or, under anonymised output, the pseudonym the identities section uses for it. Absent where the configured name carries an address, and where anonymised output has no entry a reader could resolve the pseudonym against (ADR-0068 clause 4)."
        },
        "emails": {
          "type": "array",
          "description": "The identity's addresses, each as the digest that refers to it. The first is the canonical one, which is the identity's id in the identities section.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "cardinalityLimits": {
      "type": "object",
      "additionalProperties": false,
      "description": "The cardinality limits the report was produced under, by name. They belong to the analysis plane, so a report states them and they enter the cache key (ADR-0053 clause 6), and docs/metrics.md section 12 is their only definition: a configuration that supplies one is verified against it, never applied (ADR-0062 clause 6).",
      "required": [
        "identities",
        "most_modified_files",
        "extensions",
        "directory_activity_entries",
        "coupling_pairs",
        "coupling_graph_nodes",
        "coupling_graph_edges",
        "identities_per_directory",
        "hotspot_entries",
        "churn_files",
        "bulk_commits_listed"
      ],
      "properties": {
        "identities": {
          "type": "integer"
        },
        "most_modified_files": {
          "type": "integer"
        },
        "extensions": {
          "type": "integer"
        },
        "directory_activity_entries": {
          "type": "integer"
        },
        "coupling_pairs": {
          "type": "integer"
        },
        "coupling_graph_nodes": {
          "type": "integer"
        },
        "coupling_graph_edges": {
          "type": "integer"
        },
        "identities_per_directory": {
          "type": "integer"
        },
        "hotspot_entries": {
          "type": "integer"
        },
        "churn_files": {
          "type": "integer"
        },
        "bulk_commits_listed": {
          "type": "integer"
        }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "major",
        "minor"
      ],
      "properties": {
        "major": {
          "type": "integer"
        },
        "minor": {
          "type": "integer"
        }
      }
    },
    "reasons": {
      "type": "array",
      "description": "Every family status code that applies, in enumeration order. docs/metrics.md section 13 is the authoritative list (ADR-0062 clause 6).",
      "items": {
        "type": "string",
        "enum": [
          "worktree_unavailable",
          "not_implemented",
          "empty_population",
          "cardinality_limit",
          "low_classification_confidence",
          "shallow_clone",
          "limit_reached_commits",
          "limit_reached_size",
          "limit_reached_duration",
          "limit_reached_memory",
          "symlink_escaped_root",
          "capability_unavailable_in_mode",
          "external_service_unavailable",
          "binary_file_skipped",
          "history_rewritten",
          "unresolved_identity"
        ]
      }
    },
    "confidence": {
      "type": "string",
      "description": "low: the values present may themselves be wrong. partial: the values present are correct but incomplete.",
      "enum": [
        "low",
        "partial"
      ]
    },
    "noMetrics": {
      "type": "object",
      "additionalProperties": false,
      "description": "A skipped family's metrics are empty: never null-filled, never zero-filled (ADR-0032 clause 3).",
      "required": [],
      "properties": {}
    },
    "skippedFamily": {
      "type": "object",
      "additionalProperties": false,
      "description": "Not computed, with a reason.",
      "required": [
        "version",
        "status",
        "reasons",
        "metrics"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "status": {
          "type": "string",
          "enum": [
            "skipped"
          ]
        },
        "reasons": {
          "$ref": "#/$defs/reasons"
        },
        "method": {
          "type": "string",
          "description": "How the values were derived, where that differs from a measurement or a reference implementation (ADR-0032 clause 8)."
        },
        "metrics": {
          "$ref": "#/$defs/noMetrics"
        }
      }
    },
    "temporalMetrics": {
      "type": "object",
      "additionalProperties": false,
      "description": "docs/metrics.md section 2.",
      "required": [],
      "properties": {
        "hour_histogram": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "weekday_histogram": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "night_ratio": {
          "type": "number",
          "description": "A ratio from 0 to 1."
        },
        "weekend_ratio": {
          "type": "number",
          "description": "A ratio from 0 to 1."
        },
        "friday_evening_count": {
          "type": "integer"
        },
        "busiest_day": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "date",
            "count"
          ],
          "properties": {
            "date": {
              "type": "string",
              "description": "A local calendar date, YYYY-MM-DD."
            },
            "count": {
              "type": "integer"
            }
          }
        },
        "longest_streak_days": {
          "type": "integer"
        },
        "longest_silence_days": {
          "type": "integer"
        },
        "first_commit_date": {
          "type": "string",
          "description": "A local calendar date, YYYY-MM-DD."
        },
        "last_commit_date": {
          "type": "string",
          "description": "A local calendar date, YYYY-MM-DD."
        }
      }
    },
    "commitSizeMetrics": {
      "type": "object",
      "additionalProperties": false,
      "description": "docs/metrics.md section 3.",
      "required": [],
      "properties": {
        "mean_lines": {
          "type": "number"
        },
        "median_lines": {
          "type": "number"
        },
        "largest_commit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hash",
            "date",
            "lines",
            "files"
          ],
          "properties": {
            "hash": {
              "type": "string"
            },
            "date": {
              "type": "string",
              "description": "A local calendar date, YYYY-MM-DD."
            },
            "lines": {
              "type": "integer"
            },
            "files": {
              "type": "integer"
            }
          }
        }
      }
    },
    "messagesMetrics": {
      "type": "object",
      "additionalProperties": false,
      "description": "docs/metrics.md section 4.",
      "required": [],
      "properties": {
        "conventional_ratio": {
          "type": "number",
          "description": "A ratio from 0 to 1."
        },
        "mean_subject_length": {
          "type": "number"
        },
        "revert_count": {
          "type": "integer"
        },
        "fix_typo_count": {
          "type": "integer"
        }
      }
    },
    "filesMetrics": {
      "type": "object",
      "additionalProperties": false,
      "description": "docs/metrics.md section 5.",
      "required": [],
      "properties": {
        "most_modified": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "commits",
              "removed"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "commits": {
                "type": "integer"
              },
              "removed": {
                "type": "boolean"
              }
            }
          }
        },
        "oldest_untouched": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "date"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "date": {
              "type": "string",
              "description": "A local calendar date, YYYY-MM-DD."
            }
          }
        },
        "head_file_count": {
          "type": "integer"
        },
        "tracked_text_file_count": {
          "type": "integer"
        }
      }
    },
    "couplingMetrics": {
      "type": "object",
      "additionalProperties": false,
      "description": "docs/metrics.md section 6.",
      "required": [],
      "properties": {
        "pairs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "a",
              "b",
              "support",
              "confidence",
              "expected"
            ],
            "properties": {
              "a": {
                "type": "string"
              },
              "b": {
                "type": "string"
              },
              "support": {
                "type": "integer"
              },
              "confidence": {
                "type": "number",
                "description": "A ratio from 0 to 1."
              },
              "expected": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "hotspotMetrics": {
      "type": "object",
      "additionalProperties": false,
      "description": "docs/metrics.md section 10.",
      "required": [],
      "properties": {
        "churn_files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "commits_in_window"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "commits_in_window": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "description": "One resolved contributor.",
      "required": [
        "id",
        "display_name",
        "first_commit_date",
        "last_commit_date",
        "commit_count",
        "source_address_count",
        "merge_candidates"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "The identity's stable digest: the first 16 hexadecimal characters of the SHA-256 of its canonical address (ADR-0033 clause 4)."
        },
        "display_name": {
          "type": "string",
          "description": "The resolved name, or the id where the name is empty or contains an address, or where anonymised output was requested."
        },
        "first_commit_date": {
          "type": "string",
          "description": "A local calendar date, YYYY-MM-DD."
        },
        "last_commit_date": {
          "type": "string",
          "description": "A local calendar date, YYYY-MM-DD."
        },
        "commit_count": {
          "type": "integer",
          "description": "The identity's analysed commits."
        },
        "source_address_count": {
          "type": "integer",
          "minimum": 0,
          "description": "The distinct addresses the identity's commits record before .mailmap and configuration fold them into it. The addresses are never exported (ADR-0033 clause 2). Added in document version 1.2."
        },
        "merge_candidates": {
          "type": "array",
          "description": "Suggestions that another individual entry may be the same person, ordered by id, then signal. Nothing applies them (ADR-0010 clause 4). Added in document version 1.2.",
          "items": {
            "$ref": "#/$defs/mergeCandidate"
          }
        }
      }
    },
    "mergeCandidate": {
      "type": "object",
      "additionalProperties": false,
      "description": "One merge suggestion: another entry of the identities section, and the signal that produced it (docs/metrics.md section 14).",
      "required": [
        "id",
        "signal"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "The id of the other entry."
        },
        "signal": {
          "type": "string",
          "enum": [
            "display_name",
            "local_part",
            "noreply"
          ]
        }
      }
    },
    "aggregateIdentity": {
      "type": "object",
      "additionalProperties": false,
      "description": "The one entry folding every identity beyond the individually represented limit. It has no id.",
      "required": [
        "display_name",
        "first_commit_date",
        "last_commit_date",
        "commit_count",
        "source_address_count",
        "aggregate"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "description": "States how many identities the entry represents."
        },
        "first_commit_date": {
          "type": "string",
          "description": "A local calendar date, YYYY-MM-DD."
        },
        "last_commit_date": {
          "type": "string",
          "description": "A local calendar date, YYYY-MM-DD."
        },
        "commit_count": {
          "type": "integer",
          "description": "The folded identities' analysed commits, summed."
        },
        "source_address_count": {
          "type": "integer",
          "minimum": 0,
          "description": "The folded identities' source addresses, summed. Added in document version 1.2."
        },
        "aggregate": {
          "type": "boolean",
          "enum": [
            true
          ]
        }
      }
    }
  }
}
